{
  "name": "@quanto/money",
  "version": "0.0.0",
  "description": "Money for quanto: parse \"$12\", \"\u20ac12,50\" and \"$1.2k\" into integer minor units, with loss-free operations and ranges.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "quanto": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "quanto": "workspace:*"
  }
}

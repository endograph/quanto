{
  "name": "@quantojs/datetime",
  "version": "0.2.0",
  "description": "Dates and times for quanto: parse \"tomorrow 3pm\", \"Oct 2\" and \"03/04/2026\" into ISO strings, with ranges.",
  "license": "MIT",
  "author": "rt2zz",
  "homepage": "https://github.com/endograph/quanto/tree/main/packages/datetime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endograph/quanto.git",
    "directory": "packages/datetime"
  },
  "bugs": {
    "url": "https://github.com/endograph/quanto/issues"
  },
  "keywords": [
    "quanto",
    "date",
    "time",
    "datetime",
    "parse",
    "natural-language",
    "date-range",
    "locale",
    "i18n",
    "forms"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/names/index.d.ts",
      "import": "./dist/names/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "quanto": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "quanto": "workspace:*"
  }
}

{
  "name": "quanto",
  "version": "0.0.0",
  "description": "Turn messy human text into well-typed values and back: lengths, weights, durations, money and custom types. Dates are in quanto-datetime.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "AUTHORING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./quantity": {
      "types": "./dist/quantity/index.d.ts",
      "import": "./dist/quantity/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.js"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.ts",
      "import": "./dist/codecs/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "import": "./dist/formats/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}

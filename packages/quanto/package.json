{
  "name": "quanto",
  "version": "0.5.0",
  "description": "The quanto protocol: turn messy human text into well-typed values and back. Codec contracts, definition helpers, context, issues, composition and shared parsing primitives. The codecs are in @quantojs/common.",
  "license": "MIT",
  "author": "rt2zz",
  "homepage": "https://github.com/endograph/quanto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endograph/quanto.git",
    "directory": "packages/quanto"
  },
  "bugs": {
    "url": "https://github.com/endograph/quanto/issues"
  },
  "keywords": [
    "parse",
    "format",
    "input",
    "codec",
    "units",
    "quantity",
    "locale",
    "i18n",
    "standard-schema",
    "forms"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "AUTHORING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./quantity": {
      "types": "./dist/quantity/index.d.ts",
      "import": "./dist/quantity/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "import": "./dist/formats/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@quantojs/common": "workspace:*"
  }
}

  {"name": "an untouched field doesn't parse on blur", "codec": "length", "steps": [{"event": {"type": "focus"}}, {"event": {"type": "blur"}, "raw": "", "pending": false}]},
  {"name": "blurring unedited text doesn't parse again", "codec": "length", "steps": [{"event": {"type": "focus"}}, {"event": {"type": "input", "raw": "2m"}}, {"event": {"type": "blur"}, "request": "2m"}, {"resolve": 1, "commit": {"raw": "2m", "value": {"value": 2, "unit": "m"}}}, {"event": {"type": "focus"}}, {"event": {"type": "blur"}, "raw": "2 m", "pending": false}]},

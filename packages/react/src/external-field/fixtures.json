  {"name": "retry parses again: as Enter when focused", "codec": "length", "steps": [{"event": {"type": "focus"}}, {"event": {"type": "input", "raw": "2m"}}, {"event": {"type": "enter"}, "request": "2m"}, {"reject": 1}, {"event": {"type": "retry"}, "request": "2m"}, {"resolve": 2, "raw": "2m", "commit": {"raw": "2m", "value": {"value": 2, "unit": "m"}}}]},

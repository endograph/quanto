  {"name": "refocusing without editing lets the pending parse finish and commit", "codec": "length", "steps": [{"event": {"type": "focus"}}, {"event": {"type": "input", "raw": "2m"}}, {"event": {"type": "blur"}, "request": "2m"}, {"event": {"type": "focus"}, "pending": true}, {"resolve": 1, "raw": "2 m", "commit": {"raw": "2m", "value": {"value": 2, "unit": "m"}}}]},
  {"name": "a rejected parse commits nothing, keeps the text and shows the failure", "codec": "length", "steps": [{"event": {"type": "focus"}}, {"event": {"type": "input", "raw": "2m"}}, {"event": {"type": "blur"}, "request": "2m"}, {"reject": 1, "raw": "2m", "pending": false, "failed": true, "issues": []}]},

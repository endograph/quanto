  {"name": "typing doesn't parse; blur starts a parse, and its result commits", "codec": "length", "steps": [{"event": {"type": "focus"}}, {"event": {"type": "input", "raw": "150cm"}, "raw": "150cm", "pending": false}, {"event": {"type": "blur"}, "raw": "150cm", "request": "150cm", "pending": true}, {"resolve": 1, "raw": "150 cm", "commit": {"raw": "150cm", "value": {"value": 150, "unit": "cm"}}, "pending": false, "issues": []}]},
